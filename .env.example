# Copie para .env e ajuste. NÃO versione o .env real.

# Banco. Em produção use PostgreSQL; em dev pode deixar SQLite.
DATABASE_URL=postgresql+psycopg://escala:escala@db:5432/escala
# DATABASE_URL=sqlite:///./escala.sqlite3

# Chave para sessões/senhas de gestor. Troque por um valor longo e aleatório.
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-longa

# Piso de folga mínima, em horas (regra 7.2). Padrão: 48.
FOLGA_MINIMA_HORAS=48

# Hora de início do serviço de 24h (regra 2.4). Padrão: 08:00.
HORA_INICIO_SERVICO=08:00
